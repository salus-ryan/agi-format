{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/salus-ryan/agi-format/v0.3.0/schemas/manifest-v0.1.0.json",
  "title": ".agi manifest v0.1.0",
  "type": "object",
  "required": ["format_version", "agent", "capabilities", "runtime"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "format_version": {"const": "0.1.0"},
    "agent": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"},
        "description": {"type": "string", "maxLength": 4096},
        "author": {"type": "string", "maxLength": 256},
        "license": {"type": "string", "maxLength": 128}
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["perception", "reasoning", "memory", "language", "action", "learning", "goals"],
      "additionalProperties": false,
      "properties": {
        "perception": {"$ref": "#/$defs/capability"},
        "reasoning": {"$ref": "#/$defs/capability"},
        "memory": {"$ref": "#/$defs/capability"},
        "language": {"$ref": "#/$defs/capability"},
        "action": {"$ref": "#/$defs/capability"},
        "learning": {"$ref": "#/$defs/capability"},
        "goals": {"$ref": "#/$defs/capability"}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["sandbox_required", "entrypoint"],
      "additionalProperties": false,
      "properties": {
        "min_memory_gb": {"type": "number", "minimum": 0},
        "gpu_required": {"type": "boolean"},
        "min_gpu_vram_gb": {"type": ["number", "null"], "minimum": 0},
        "sandbox_required": {"const": true},
        "entrypoint": {"$ref": "#/$defs/safePath"}
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
    },
    "capability": {
      "type": "object",
      "required": ["module", "required"],
      "additionalProperties": false,
      "properties": {
        "module": {"$ref": "#/$defs/safePath"},
        "required": {"const": true}
      }
    }
  }
}
