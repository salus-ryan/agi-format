{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/salus-ryan/agi-format/v0.5.0/schemas/signature-v0.2.0.json",
  "title": ".agi package signature v0.2.0",
  "type": "object",
  "required": ["algorithm", "public_key", "content_sha256", "signature"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "algorithm": {"const": "ed25519"},
    "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
