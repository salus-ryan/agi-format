{
  "name": "perception",
  "version": "0.1.0",
  "description": "Multimodal perception and grounding. Converts raw inputs into unified internal representations (Percepts) grounded in a world model.",
  "components": [
    {
      "name": "text_adapter",
      "path": "adapters/text.json",
      "type": "adapter",
      "interface": "InputAdapter<string, Percept>"
    },
    {
      "name": "vision_adapter",
      "path": "adapters/vision.json",
      "type": "adapter",
      "interface": "InputAdapter<ImageBuffer, Percept>"
    },
    {
      "name": "audio_adapter",
      "path": "adapters/audio.json",
      "type": "adapter",
      "interface": "InputAdapter<AudioBuffer, Percept>"
    },
    {
      "name": "structured_adapter",
      "path": "adapters/structured.json",
      "type": "adapter",
      "interface": "InputAdapter<JSON, Percept>"
    },
    {
      "name": "grounding_engine",
      "path": "grounding/grounding.json",
      "type": "engine",
      "interface": "Grounder<Percept[], GroundedState>"
    }
  ],
  "dependencies": [],
  "inputs": [
    { "name": "raw_input", "type": "MultimodalInput", "from": "environment" }
  ],
  "outputs": [
    { "name": "percepts", "type": "Percept[]", "to": "memory.update" },
    { "name": "grounded_state", "type": "GroundedState", "to": "reasoning.inference" }
  ]
}
