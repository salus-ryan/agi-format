{
  "name": "text_adapter",
  "description": "Converts raw text input into tokenized Percept representations.",
  "input_type": "string",
  "output_type": "Percept",
  "config": {
    "tokenizer": {
      "type": "bpe",
      "vocab_size": 128000,
      "model_ref": "weights/tokenizer.json"
    },
    "max_input_length": 131072,
    "encoding": "utf-8",
    "embedding_dim": 4096,
    "normalize": true
  }
}
