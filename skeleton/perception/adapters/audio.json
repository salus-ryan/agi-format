{
  "name": "audio_adapter",
  "description": "Converts audio input (speech, sounds) into auditory Percept representations.",
  "input_type": "AudioBuffer",
  "output_type": "Percept",
  "config": {
    "encoder": {
      "type": "whisper",
      "variant": "large-v3",
      "model_ref": "weights/audio_encoder.safetensors"
    },
    "sample_rate": 16000,
    "supported_formats": ["wav", "mp3", "flac", "ogg"],
    "max_duration_seconds": 600,
    "embedding_dim": 4096,
    "features": {
      "speech_to_text": true,
      "speaker_diarization": true,
      "sound_classification": true
    }
  }
}
