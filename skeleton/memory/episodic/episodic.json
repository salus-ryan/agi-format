{
  "name": "episodic_store",
  "description": "Episodic memory -- records of past experiences with temporal context. 'What happened, when, and how did it turn out?' Enables learning from specific past situations.",
  "config": {
    "backend": {
      "type": "vector_store",
      "engine": "hnswlib",
      "embedding_dim": 4096,
      "distance_metric": "cosine",
      "max_elements": 1000000
    },
    "storage": {
      "path": "memory/episodic/episodes.db",
      "persistence": "on_write",
      "compression": "zstd"
    },
    "episode_schema": {
      "timestamp": "iso8601",
      "state_before": "Embedding",
      "action_taken": "Action",
      "observation": "Observation",
      "reward": "float",
      "state_after": "Embedding",
      "tags": "string[]",
      "importance": "float (0-1)"
    },
    "retrieval": {
      "by_similarity": true,
      "by_recency": true,
      "by_importance": true,
      "combined_scoring": "weighted_sum",
      "weights": { "similarity": 0.5, "recency": 0.3, "importance": 0.2 },
      "max_results": 20
    },
    "decay": {
      "enabled": true,
      "half_life_steps": 100000,
      "min_importance_to_persist": 0.1
    }
  }
}
