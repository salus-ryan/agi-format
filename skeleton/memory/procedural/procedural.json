{
  "name": "procedural_store",
  "description": "Procedural memory -- learned skills and routines. 'How to do things.' Stores reusable action sequences that have been refined through experience.",
  "config": {
    "storage": {
      "path": "memory/procedural/procedures.db",
      "persistence": "on_write"
    },
    "procedure_schema": {
      "name": "string",
      "description": "string",
      "preconditions": "Condition[]",
      "steps": "Action[]",
      "postconditions": "Condition[]",
      "success_rate": "float (0-1)",
      "times_executed": "integer",
      "last_executed": "iso8601",
      "learned_from": "Episode[] (refs)"
    },
    "retrieval": {
      "by_name": true,
      "by_precondition_match": true,
      "by_goal_relevance": true,
      "max_results": 10
    },
    "refinement": {
      "enabled": true,
      "description": "Procedures are refined over time based on success/failure outcomes",
      "min_executions_before_refinement": 3,
      "refinement_strategy": "outcome_weighted_averaging"
    },
    "composition": {
      "enabled": true,
      "description": "Procedures can be composed into higher-level procedures",
      "max_nesting_depth": 5
    }
  }
}
