{
  "name": "memory",
  "version": "0.1.0",
  "description": "Multi-store memory system. Episodic (experiences), semantic (facts), working (active context), and procedural (learned skills). Provides the agent's continuity across time.",
  "components": [
    {
      "name": "episodic_store",
      "path": "episodic/episodic.json",
      "type": "store",
      "interface": "MemoryStore<Episode, EpisodicQuery, Episode[]>"
    },
    {
      "name": "semantic_store",
      "path": "semantic/semantic.json",
      "type": "store",
      "interface": "MemoryStore<Fact, SemanticQuery, Fact[]>"
    },
    {
      "name": "working_memory",
      "path": "working/working.json",
      "type": "store",
      "interface": "WorkingMemory<State, Percept | Observation, State>"
    },
    {
      "name": "procedural_store",
      "path": "procedural/procedural.json",
      "type": "store",
      "interface": "MemoryStore<Procedure, ProceduralQuery, Procedure[]>"
    }
  ],
  "dependencies": [],
  "inputs": [
    { "name": "percepts", "type": "Percept[]", "from": "perception.observe" },
    { "name": "observations", "type": "Observation[]", "from": "action.execute" },
    { "name": "learning_updates", "type": "MemoryUpdate[]", "from": "learning.consolidate" }
  ],
  "outputs": [
    { "name": "state", "type": "State", "to": "reasoning.inference" },
    { "name": "relevant_memories", "type": "Memory[]", "to": "reasoning.inference" },
    { "name": "procedures", "type": "Procedure[]", "to": "action.execute" }
  ]
}
