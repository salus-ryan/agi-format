{
  "name": "reasoning",
  "version": "0.1.0",
  "description": "Core reasoning engine. Handles inference, causal modeling, hierarchical planning, and formal verification. This is the 'thinking' module.",
  "components": [
    {
      "name": "inference_engine",
      "path": "inference/engine.json",
      "type": "engine",
      "interface": "InferenceEngine<State, Query, Response>"
    },
    {
      "name": "world_model",
      "path": "causal/world_model.json",
      "type": "engine",
      "interface": "WorldModel<State, Action, PredictedState>"
    },
    {
      "name": "planner",
      "path": "planning/planner.json",
      "type": "planner",
      "interface": "Planner<State, Goal, Plan>"
    },
    {
      "name": "formal_verifier",
      "path": "formal/verifier.json",
      "type": "engine",
      "interface": "Verifier<Proposition, ProofResult>"
    }
  ],
  "dependencies": ["perception", "memory"],
  "inputs": [
    { "name": "state", "type": "State", "from": "memory.working" },
    { "name": "grounded_percepts", "type": "GroundedState", "from": "perception.grounding_engine" },
    { "name": "goal", "type": "Goal", "from": "goals.select" }
  ],
  "outputs": [
    { "name": "plan", "type": "Plan", "to": "action.execute" },
    { "name": "decision", "type": "Action", "to": "action.execute" },
    { "name": "should_replan", "type": "boolean", "to": "goals.goal_loop" }
  ]
}
