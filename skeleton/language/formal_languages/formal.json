{
  "name": "formal_languages",
  "description": "Formal language processing -- code, math, logic. Parse, generate, and reason in structured notations. Bridges natural language reasoning with formal verification.",
  "input_type": "string",
  "output_type": "AST",
  "config": {
    "languages": [
      {
        "name": "python",
        "parser": "tree-sitter",
        "type_checker": "mypy",
        "executor": "sandbox"
      },
      {
        "name": "javascript",
        "parser": "tree-sitter",
        "type_checker": "typescript",
        "executor": "sandbox"
      },
      {
        "name": "lean4",
        "parser": "lean",
        "purpose": "theorem_proving"
      },
      {
        "name": "first_order_logic",
        "parser": "custom",
        "purpose": "formal_reasoning"
      },
      {
        "name": "latex_math",
        "parser": "katex",
        "purpose": "mathematical_notation"
      }
    ],
    "capabilities": {
      "parse_to_ast": true,
      "ast_to_code": true,
      "cross_language_translation": true,
      "semantic_diff": true,
      "refactoring": true
    },
    "verification_ref": "reasoning/formal/verifier.json"
  }
}
