{
  "name": "nlu",
  "description": "Natural language understanding. Parses text into semantic frames capturing intent, entities, relations, implicature, and pragmatic context. Goes beyond surface-level parsing.",
  "input_type": "Token[]",
  "output_type": "SemanticFrame",
  "config": {
    "pipeline": [
      {
        "stage": "tokenization",
        "ref": "perception/adapters/text.json"
      },
      {
        "stage": "semantic_parsing",
        "description": "Extract structured meaning from token sequence",
        "model_ref": "reasoning/inference/engine.json",
        "output": "SemanticFrame"
      },
      {
        "stage": "intent_resolution",
        "description": "Resolve the speaker's communicative intent (request, inform, question, etc.)",
        "taxonomy": "dialogue_acts"
      },
      {
        "stage": "pragmatic_inference",
        "description": "Infer implicature, presupposition, and indirect speech acts",
        "requires": "theory_of_mind"
      }
    ],
    "semantic_frame_schema": {
      "intent": "string",
      "entities": [{ "text": "string", "type": "string", "resolved": "Entity | null" }],
      "relations": [{ "subject": "Entity", "predicate": "string", "object": "Entity" }],
      "modality": "assertion | question | command | conditional",
      "confidence": "float (0-1)",
      "implicatures": "string[]"
    }
  }
}
