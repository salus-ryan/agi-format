{
  "name": "nlg",
  "description": "Natural language generation. Converts semantic frames and internal states into fluent, contextually appropriate natural language output.",
  "input_type": "SemanticFrame",
  "output_type": "Token[]",
  "config": {
    "backend": {
      "model_ref": "reasoning/inference/engine.json",
      "description": "Generation is handled by the base inference engine with appropriate prompting"
    },
    "generation_modes": [
      {
        "name": "conversational",
        "description": "Natural dialogue responses",
        "style": "adaptive_to_interlocutor"
      },
      {
        "name": "explanatory",
        "description": "Step-by-step explanations of reasoning",
        "include_confidence": true,
        "include_alternatives": true
      },
      {
        "name": "precise",
        "description": "Minimal, unambiguous output (for tool calls, structured responses)",
        "format": "structured"
      }
    ],
    "constraints": {
      "max_output_tokens": 32768,
      "honesty": {
        "express_uncertainty": true,
        "distinguish_fact_from_inference": true,
        "cite_sources_when_available": true
      },
      "audience_adaptation": {
        "enabled": true,
        "tom_ref": "language/theory_of_mind/tom.json"
      }
    }
  }
}
