{
  "name": "language",
  "version": "0.1.0",
  "description": "Natural and formal language processing. Understanding, generation, formal language handling (code/math/logic), and theory of mind for modeling other agents.",
  "components": [
    {
      "name": "nlu",
      "path": "understanding/nlu.json",
      "type": "engine",
      "interface": "NLU<Token[], SemanticFrame>"
    },
    {
      "name": "nlg",
      "path": "generation/nlg.json",
      "type": "engine",
      "interface": "NLG<SemanticFrame, Token[]>"
    },
    {
      "name": "formal_languages",
      "path": "formal_languages/formal.json",
      "type": "engine",
      "interface": "FormalLang<string, AST>"
    },
    {
      "name": "theory_of_mind",
      "path": "theory_of_mind/tom.json",
      "type": "engine",
      "interface": "ToM<AgentModel, State, BeliefState>"
    }
  ],
  "dependencies": ["reasoning", "memory"],
  "inputs": [
    { "name": "text_input", "type": "Token[]", "from": "perception.text_adapter" },
    { "name": "state", "type": "State", "from": "memory.working" },
    { "name": "generation_request", "type": "SemanticFrame", "from": "reasoning.inference" }
  ],
  "outputs": [
    { "name": "understood", "type": "SemanticFrame", "to": "reasoning.inference" },
    { "name": "generated_text", "type": "Token[]", "to": "action.communicate" },
    { "name": "belief_model", "type": "BeliefState", "to": "reasoning.inference" }
  ]
}
