{
  "name": "sandbox",
  "description": "Execution sandbox. Constrains the agent's actions to prevent unintended side effects. All tool executions pass through the sandbox before reaching the real world.",
  "config": {
    "execution": {
      "shell_enabled": false,
      "python_enabled": false,
      "allowed_commands": ["pwd", "ls", "echo", "printf", "wc", "head", "tail", "sort", "uniq"]
    },
    "isolation": {
      "type": "disabled",
      "description": "Process execution is disabled because this package does not declare an OCI image.",
      "runtime": "none",
      "image": "",
      "fallback": "deny"
    },
    "resource_limits": {
      "max_cpu_seconds_per_action": 60,
      "max_memory_mb": 4096,
      "max_disk_mb": 10240,
      "max_network_connections": 10,
      "max_concurrent_actions": 4
    },
    "filesystem": {
      "writable_paths": ["workspace/", "memory/"],
      "readable_paths": ["weights/", "config/"],
      "blocked_paths": ["/etc/", "/sys/", "/proc/", "~/.ssh/"],
      "max_file_size_mb": 100
    },
    "network": {
      "allowed_domains": [],
      "blocked_domains": [],
      "policy": "allowlist",
      "description": "By default, no network access. Domains must be explicitly allowed."
    },
    "action_logging": {
      "log_all_actions": true,
      "log_path": "memory/action_log.jsonl",
      "include_inputs": true,
      "include_outputs": true,
      "redact_secrets": true
    },
    "rollback": {
      "enabled": true,
      "description": "Filesystem changes can be rolled back if an action sequence fails",
      "snapshot_before_action": true
    }
  }
}
