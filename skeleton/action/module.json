{
  "name": "action",
  "version": "0.1.0",
  "description": "Action execution and tool use. Manages available tools, sandboxed execution, and the action-observation feedback loop. The agent's interface with the external world.",
  "components": [
    {
      "name": "tool_registry",
      "path": "tools/tools.json",
      "type": "tool",
      "interface": "ToolRegistry<ToolSpec[], ToolCall, ToolResult>"
    },
    {
      "name": "sandbox",
      "path": "sandbox/sandbox.json",
      "type": "policy",
      "interface": "Sandbox<Action, SandboxResult>"
    },
    {
      "name": "feedback_loop",
      "path": "feedback/feedback.json",
      "type": "engine",
      "interface": "FeedbackLoop<Action, Observation, Reward>"
    }
  ],
  "dependencies": ["reasoning", "goals"],
  "inputs": [
    { "name": "action", "type": "Action", "from": "reasoning.decide" },
    { "name": "alignment_approved", "type": "boolean", "from": "goals.check_alignment" }
  ],
  "outputs": [
    { "name": "observation", "type": "Observation", "to": "memory.update" },
    { "name": "reward", "type": "Reward", "to": "learning.update" },
    { "name": "tool_result", "type": "ToolResult", "to": "reasoning.inference" }
  ]
}
