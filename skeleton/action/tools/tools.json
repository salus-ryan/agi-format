{
  "name": "tool_registry",
  "description": "Registry of available tools the agent can use. Each tool has a schema describing its inputs, outputs, and constraints. New tools can be learned at runtime.",
  "config": {
    "discovery": {
      "static_tools": "defined below",
      "dynamic_discovery": true,
      "description": "Agent can discover and learn to use new tools through exploration"
    },
    "tools": [
      {
        "name": "shell",
        "description": "Execute shell commands in a sandboxed environment",
        "input_schema": {
          "command": "string",
          "workdir": "string (optional)",
          "timeout_ms": "integer (optional, default 30000)"
        },
        "output_schema": {
          "stdout": "string",
          "stderr": "string",
          "exit_code": "integer"
        },
        "sandbox_level": "strict",
        "requires_approval": false
      },
      {
        "name": "file_read",
        "description": "Read contents of a file",
        "input_schema": {
          "path": "string",
          "offset": "integer (optional)",
          "limit": "integer (optional)"
        },
        "output_schema": {
          "content": "string",
          "size_bytes": "integer"
        },
        "sandbox_level": "read_only"
      },
      {
        "name": "file_write",
        "description": "Write contents to a file",
        "input_schema": {
          "path": "string",
          "content": "string"
        },
        "output_schema": {
          "success": "boolean",
          "bytes_written": "integer"
        },
        "sandbox_level": "write",
        "requires_approval_if": "path outside sandbox"
      },
      {
        "name": "web_request",
        "description": "Make HTTP requests to external services",
        "input_schema": {
          "method": "GET | POST | PUT | DELETE",
          "url": "string",
          "headers": "object (optional)",
          "body": "string (optional)"
        },
        "output_schema": {
          "status_code": "integer",
          "headers": "object",
          "body": "string"
        },
        "sandbox_level": "network",
        "requires_approval_if": "url not in allowlist"
      },
      {
        "name": "communicate",
        "description": "Send a message to a human or another agent",
        "input_schema": {
          "recipient": "string (agent_id or 'human')",
          "message": "string",
          "modality": "text | voice"
        },
        "output_schema": {
          "delivered": "boolean",
          "response": "string (optional, if synchronous)"
        },
        "sandbox_level": "none"
      }
    ]
  }
}
