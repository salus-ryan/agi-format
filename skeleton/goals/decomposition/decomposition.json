{
  "name": "goal_decomposer",
  "description": "Goal decomposition. Breaks high-level objectives into concrete, achievable subgoals. Handles ambiguous goals by asking for clarification or making reasonable assumptions.",
  "config": {
    "decomposition_strategy": {
      "type": "hierarchical",
      "max_depth": 5,
      "max_subgoals_per_level": 10,
      "min_subgoal_granularity": "single_action_achievable"
    },
    "goal_schema": {
      "id": "string (uuid)",
      "description": "string (natural language)",
      "parent_goal": "string (uuid) | null",
      "success_criteria": [
        {
          "description": "string",
          "type": "boolean | numeric | qualitative",
          "target": "any",
          "verifiable": "boolean"
        }
      ],
      "priority": "float (0-1)",
      "deadline": "iso8601 | null",
      "status": "pending | active | completed | failed | abandoned",
      "subgoals": "Goal[]"
    },
    "ambiguity_handling": {
      "strategy": "ask_then_assume",
      "description": "If goal is ambiguous, first try to ask the user for clarification. If not possible, make the most reasonable assumption and log it.",
      "max_clarification_attempts": 2,
      "log_assumptions": true
    },
    "prioritization": {
      "method": "weighted_multi_criteria",
      "criteria": [
        { "name": "urgency", "weight": 0.3 },
        { "name": "importance", "weight": 0.3 },
        { "name": "dependency_order", "weight": 0.2 },
        { "name": "estimated_effort", "weight": 0.1 },
        { "name": "user_preference", "weight": 0.1 }
      ]
    }
  }
}
